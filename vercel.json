{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "angular",
      "routePrefix": "/"
    },
    "backend": {
      "root": "backend",
      "runtime": "node",
      "framework": "express",
      "entrypoint": "app.js",
      "routePrefix": "/api"
    }
  }
}